# 复制为根目录 .env，由 docker compose 自动读取；请使用单引号包裹含 $、# 的值。
TZ=Asia/Shanghai
APP_BIND_IP=0.0.0.0
JAVA_HOST_PORT=4444
FACE_DATABASE_DIR=./apps/api/python/face_database

# MySQL / Redis 凭据由容器初始化服务生成并保存在专用数据卷，无需填写。
# 平台管理员密码和应用签名密钥由部署者设置；不提交真实 .env。
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
PYTHON_SECRET_KEY=

# AI 可选；不填则不提供第三方平台密钥。
POLYMAS_AUTH_KEY=
POLYMAS_APP_CODE=
POLYMAS_USER_NID=
POLYMAS_SESSION_NID=
POLYMAS_CHAT_NID=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REQUEST_TIMEOUT=60000
MEDIA_PUBLIC_URL_PREFIX=
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=120

# 可替换为服务器可访问的镜像仓库或经过验证的固定 digest。
MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:7.2-alpine
MAVEN_IMAGE=maven:3.9-eclipse-temurin-25
JAVA_IMAGE=eclipse-temurin:25-jre
PYTHON_IMAGE=python:3.11-slim-bookworm
NODE_IMAGE=node:22-alpine
PIP_INDEX_URL=https://pypi.org/simple
