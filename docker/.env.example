# 从仓库根目录使用 --env-file docker/.env；请使用单引号包裹含 $、# 的值。
TZ=Asia/Shanghai
APP_BIND_IP=127.0.0.1
JAVA_HOST_PORT=80
PYTHON_HOST_PORT=8080
FACE_DATABASE_DIR=../API/PythonAPI/face_database

# 必填项故意留空，未配置时 Compose 会明确报错。
# 现有 MySQL 初始化脚本直接拼接 SQL；密码请用随机字母和数字。
MYSQL_ROOT_PASSWORD=
BUCTTA_JAVA_DB_PASSWORD=
BUCTTA_PYTHON_DB_PASSWORD=
REDIS_PASSWORD=
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
PYTHON_SECRET_KEY=

# AI 可选；不填则不提供第三方平台密钥。
POLYMAS_AUTH_KEY=
MEDIA_PUBLIC_URL_PREFIX=
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=120

# 可替换为服务器可访问的镜像仓库或经过验证的固定 digest。
MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:7.2-alpine
MAVEN_IMAGE=maven:3.9-eclipse-temurin-25
JAVA_IMAGE=eclipse-temurin:25-jre
PYTHON_IMAGE=python:3.11-slim-bookworm
PIP_INDEX_URL=https://pypi.org/simple
