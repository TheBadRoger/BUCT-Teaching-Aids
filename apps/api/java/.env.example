# 本文件仅供本地开发；生产数据库和 Redis 凭据由容器生成。
# JavaAPI standalone deployment env vars
# Copy this file to .env in the same directory and fill real values.

# Ports
SERVER_PORT=80
MYSQL_HOST=localhost
MYSQL_PORT=3306
REDIS_HOST=localhost
REDIS_PORT=6379

# Spring profile
SPRING_PROFILES_ACTIVE=dev

# Explicit Docker Compose switch in dev profile (true=use compose, false=disable)
SPRING_DOCKER_COMPOSE_ENABLED=false

# Local development database credentials
MYSQL_USER=java_springboot_buctta
BUCTTA_JAVA_DB_PASSWORD=replace_with_java_db_password

# Admin account for standalone deployment
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace_with_admin_password

# Redis password for standalone deployment
REDIS_PASSWORD=replace_with_redis_password

# External AI (polymas) auth key — put the REAL jwt key here in your local .env
# (this key was previously hardcoded in source and has leaked; rotate it on polymas)
POLYMAS_AUTH_KEY=
POLYMAS_APP_CODE=
POLYMAS_USER_NID=
POLYMAS_SESSION_NID=
POLYMAS_CHAT_NID=


# 教师 AI（密钥仅保存在服务端）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REQUEST_TIMEOUT=60000
